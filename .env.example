# Required: AWS credentials to read reports from S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Required: S3 location
REPORTS_S3_BUCKET=pre-bee-test-reports
REPORTS_S3_ROOT_PREFIX=bee-beepro-frontend-e2e

# Optional: cache TTLs (milliseconds)
FILTERS_CACHE_TTL_MS=60000
MANIFEST_CACHE_TTL_MS=60000
